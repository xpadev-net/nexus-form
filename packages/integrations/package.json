  },
  "dependencies": {
    "@nexus-form/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
