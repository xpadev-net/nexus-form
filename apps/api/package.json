{
  "name": "@nexus-form/api",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsdown && node ../../scripts/assert-no-test-artifacts.mjs dist",
    "start": "node dist/index.mjs",
    "type-check": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@nexus-form/database": "workspace:*",
    "@nexus-form/integrations": "workspace:*",
    "@nexus-form/shared": "workspace:*",
    "@nexus-form/validation-provider-discord": "workspace:*",
    "@nexus-form/validation-provider-github": "workspace:*",
    "@nexus-form/validation-provider-twitter": "workspace:*",
    "@octokit/auth-app": "^7.2.2",
    "@octokit/rest": "^21.1.1",
    "@sentry/node": "^10.68.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "safe-regex2": "^5.1.1",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.4",
    "@types/uuid": "^10.0.0",
    "glob": "^11.1.0",
    "mysql2": "^3.23.2",
    "rollup": "^4.61.0",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
